        if (s_cjk_glyphs16[mid].codepoint == cp) {
            return s_cjk_glyphs16[mid].bitmap;
        } else if (s_cjk_glyphs16[mid].codepoint < cp) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    return 0; /* Not found */
}
