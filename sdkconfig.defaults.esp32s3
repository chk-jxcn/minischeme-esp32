# ESP32-S3 research board: Waveshare ESP32-S3-LCD-1.47 (ESP32-S3R8, 16 MB flash, 8 MB
# octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_s3.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_s3.csv"
# the only port is the chip's own USB
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# stacks: the sizes in sdkconfig.defaults are the least the ESP32 gets by with; this chip
# has the RAM for roomy ones (the main task overflowed 9216 here)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_TIMER_TASK_STACK_SIZE=3584
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072
# PSRAM in the malloc pool: allocations over 4 KB, WiFi / lwIP buffers and the Bluetooth host go
# there; the VM heap asks for internal RAM itself (main.c VM_HEAP_CAPS, alloc_aligned8)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
