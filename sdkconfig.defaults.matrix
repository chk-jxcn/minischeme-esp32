# Waveshare ESP32-S3-Matrix (ESP32-S3FH4R2: 4 MB flash, 2 MB quad PSRAM), on top of
# sdkconfig.defaults.esp32s3: build with -DMINI_BOARD=matrix (CMakeLists.txt)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_matrix.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_matrix.csv"
# the firmware has to fit 4 MB next to the fonts and the files: built for size like the
# ESP32's (the VM component keeps -O2)
CONFIG_COMPILER_OPTIMIZATION_PERF=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_SPIRAM_MODE_OCT=n
CONFIG_SPIRAM_MODE_QUAD=y
